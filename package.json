{
  "name": "aws-study",
  "version": "0.1.0",
  "description": "Multi-Lambda TypeScript scaffold orchestrated with AWS SAM. Local testing via LocalStack: unit (Vitest), E2E (Playwright), performance (k6).",
  "private": true,
  "type": "commonjs",
  "packageManager": "npm@9.9.3",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "sam build",
    "build:ts": "tsc --noEmit",
    "clean": "rm -rf .aws-sam coverage test-results playwright-report",
    "deploy": "sam build && sam deploy",
    "deploy:guided": "sam build && sam deploy --guided",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "validate": "sam validate --lint",
    "test": "npm run typecheck && npm run lint && npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "bash scripts/e2e-stack.sh",
    "test:e2e:ui": "bash scripts/e2e-stack.sh --ui",
    "test:e2e:headed": "bash scripts/e2e-stack.sh --headed",
    "stack:up": "docker-compose up -d localstack",
    "stack:down": "docker-compose stop localstack",
    "stack:logs": "docker-compose logs -f localstack",
    "stack:wait": "bash scripts/localstack-wait.sh",
    "stack:deploy": "bash scripts/localstack-deploy.sh",
    "dev:stack": "bash scripts/localstack-dev.sh",
    "stack:url": "bash scripts/localstack-url.sh",
    "stack:status": "curl -s http://localhost:4566/_localstack/health; echo",
    "test:perf": "echo 'Full suite (auto-boots LocalStack): npm run tests:perf' && echo 'Singles: npm run test:perf:products:docker | npm run test:perf:products'",
    "tests:perf": "bash scripts/perf-suite.sh",
    "test:perf:products": "k6 run tests/performance/products/create-products-load-test.ts",
    "test:perf:products:docker": "bash scripts/k6-docker.sh tests/performance/products/create-products-load-test.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.6.0",
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/lib-dynamodb": "^3.1149.0",
    "@middy/core": "^6.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.49.1",
    "@types/aws-lambda": "^8.10.15",
    "@types/k6": "^2.3.0",
    "@types/node": "^20.17.0",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "typescript": "~5.6.3",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,js,json}": ["biome check --write --no-errors-on-unmatched"]
  }
}
